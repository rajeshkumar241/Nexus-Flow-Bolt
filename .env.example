# Nexus Flow AI - Environment Configuration
# ===========================================

# MongoDB - with graceful fallback (5s timeout, offline mode if unavailable)
# Solution 1: Local (requires MongoDB service running)
MONGO_URI=mongodb://localhost:27017/nexus_flow
# Solution 2: Atlas (works on any device, no local service needed)
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/nexus_flow?retryWrites=true&w=majority
MONGO_TIMEOUT_MS=5000

# Emergent AI - Primary Agent (Planning, Architecture, Analysis, Debugging)
# Get your API key at https://emergent.sh/
EMERGENT_API_KEY=your_emergent_api_key_here
EMERGENT_API_URL=https://api.emergent.sh/v1
EMERGENT_MODEL=emergent-ai

# Groq API - Meta Llama 3.3 (Fallback 2)
# Get your API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API - Fallback Provider (Primary: gemini-3.1-pro-preview, Fallback: gemini-2.5-flash -> gemini-1.5-flash)
# Get your API key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview

# DeepSeek API - Fallback Provider
# Get your API key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API - Fallback Provider
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Flask
FLASK_SECRET_KEY=nexusflow123
